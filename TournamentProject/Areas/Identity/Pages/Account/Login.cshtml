@page
@model TournamentProject.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Log in";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Link necessary stylesheets -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/css/validation.css" rel="stylesheet">
    <script src="https://kit.fontawesome.com/9682b0efe9.js" crossorigin="anonymous"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
</head>
<body>
    <div class="wrapper">
        <form method="post"> <!-- Removed the asp-page-handler; the form will call OnPostAsync -->
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <h1>ورود</h1>

            <!-- Email input -->
            <div class="input-box">
                <input asp-for="Input.Email" class="form-control" placeholder="ایمیل" dir="rtl" />
                <i class="fa-solid fa-envelope"></i>
                <span asp-validation-for="Input.Email" class="validation-message"></span>
            </div>

            <!-- Password input -->
            <div class="input-box">
                <input asp-for="Input.Password" type="password" class="form-control" placeholder="رمز عبور" dir="rtl" />
                <i class="fa-solid fa-lock"></i>
                <span asp-validation-for="Input.Password" class="validation-message"></span>
            </div>

            <!-- Remember me checkbox -->
            <div class="remember-forgot">
                <label class="form-check-label">
                    <input asp-for="Input.RememberMe" class="form-check-input" /> به خاطر سپردن نام کابری
                </label>
                <a asp-page="./ForgotPassword">فراموشی رمز عبور</a>
            </div>

            <!-- Submit button -->
            <button type="submit" class="btn btn-primary">ورود</button>

            <!-- Register link -->
            <div class="register-link">
                <p>حساب کاربری ندارید؟ <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">ثبت نام</a></p>
            </div>
        </form>
    </div>
</body>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
}
</html>
