@using TournamentProject.ViewModels
@model LoginVM
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Signup</title>
    <link rel="stylesheet" href="~/css/validation.css">
    <link href="~/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://kit.fontawesome.com/9682b0efe9.js" crossorigin="anonymous"></script>
</head>
<body>
    <div class="wrapper">
        <form action="" method="post">
            <h1>ثبت نام</h1>
            <div class="input-box">
                <input type="text" placeholder="ایمیل" required dir="rtl">
                <i class="fa-solid fa-envelope"></i>
            </div>
            <div class="input-box">
                <input type="password" placeholder="رمز عبور" required dir="rtl">
                <i class="fa-solid fa-lock"></i>
            </div>
            <div class="input-box">
                <input type="password" placeholder="تکرار رمز عبور" required dir="rtl">
                <i class="fa-solid fa-lock"></i>
            </div>
            <button type="submit" class="btn">ثبت نام</button>
            <div class="register-link">
                <p>حساب کاربری دارید؟ <a href="./login.html">ورود</a></p>
            </div>
        </form>
    </div>
</body>
</html>
