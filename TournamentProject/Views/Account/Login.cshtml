@using TournamentProject.ViewModels
@model LoginVM
<!DOCTYPE html>
<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.rtl.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="~/css/validation.css">
    <link href="~/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://kit.fontawesome.com/9682b0efe9.js" crossorigin="anonymous"></script>
</head>
<body>
    <div class="wrapper">
        <form action="" method="post">
            <h1>ورود</h1>
            <div class="input-box">
                <input asp-for="UserName" type="text" placeholder="ایمیل" required dir="rtl">
                <i class="fa-solid fa-envelope"></i>
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>
            <div class="input-box">
                <input asp-for="Password" type="password" placeholder="رمز عبور" required dir="rtl">
                <i class="fa-solid fa-lock"></i>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="remember-forgot">
                <label class="form-check-label" for=""><input asp-for="RememberMe" type="checkbox">به خاطر سپردن نام کابری</label>
                <a href="#">فراموشی رمز عبور</a>
            </div>
            <button type="submit" class="btn">ورود</button>
            <div class="register-link">
                <p>حساب کاربری ندارید؟ <a asp-controller="Account" asp-action="Register">ثبت نام</a></p>
            </div>
        </form>
    </div>
</body>
@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}


</html>
