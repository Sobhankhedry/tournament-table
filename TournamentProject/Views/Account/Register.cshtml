@using TournamentProject.ViewModels
@model RegisterVM

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Signup</title>
    <link rel="stylesheet" href="~/css/validation.css">
    <link href="~/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://kit.fontawesome.com/9682b0efe9.js" crossorigin="anonymous"></script>
</head>
<body>
    <div class="wrapper">
        <form asp-action="Register" , method="post">
            <h1>ثبت نام</h1>
            <div class="input-box">
                <input asp-for="Name" type="text" placeholder="نام و نام خانوادگی" required dir="rtl">
                <i class="fa-solid fa-envelope"></i>
                <span asp-validation-for="Name" class="validation-message"></span>
            </div>
            <div class="input-box">
                <input asp-for="Email" type="text" placeholder="ایمیل" required dir="rtl">
                <i class="fa-solid fa-envelope"></i>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="input-box">
                <input asp-for="Password" type="password" placeholder="رمز عبور" required dir="rtl">
                <i class="fa-solid fa-lock"></i>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="input-box">
                <input asp-for="ConfirmPassword" type="password" placeholder="تکرار رمز عبور" required dir="rtl">
                <i class="fa-solid fa-lock"></i>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn">ثبت نام</button>
            <div class="register-link">
                <p>حساب کاربری دارید؟ <a asp-controller="Account" asp-action="Register">ورود</a></p>
            </div>
        </form>
    </div>
</body>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}



</html>
