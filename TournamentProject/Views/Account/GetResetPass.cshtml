@using TournamentProject.ViewModels
@model GetResetPassVM
<h2>ٍEnter Confirmed</h2>
<form method="post" asp-action="GetResetPass">
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Token" />
    <input asp-for="Password" type="text" placeholder="پسورد" dir="rtl">
    <input asp-for="ConfirmPassword" type="text" placeholder="تکرار پسورد" dir="rtl">
    <button type="submit" class="btn">ثبت</button>
</form>