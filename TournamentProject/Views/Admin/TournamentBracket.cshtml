        function highlightWinners() {
            // Highlight winners for each match
            const allBrackets = document.querySelectorAll('.bracketbox');

            allBrackets.forEach(bracketBox => {
                // Skip the final winner box
                if (bracketBox.classList.contains('winner')) return;

                const teamAElement = bracketBox.querySelector('.team-a');
                const teamBElement = bracketBox.querySelector('.team-b');

                // Ensure both teams exist
                if (!teamAElement || !teamBElement) {
                    console.warn('Missing team elements in bracketBox:', bracketBox);
                    return; // Skip this bracket box
                }

                // Get scores from the inputs
                const teamAScoreInput = teamAElement.querySelector('.team-score');
                const teamBScoreInput = teamBElement.querySelector('.team-score');

                // Ensure score inputs exist
                if (!teamAScoreInput || !teamBScoreInput) {
                    console.warn('Missing score inputs in bracketBox:', bracketBox);
                    return; // Skip this bracket box
                }

                // Parse scores
                const teamAScore = parseInt(teamAScoreInput.value) || 0;
                const teamBScore = parseInt(teamBScoreInput.value) || 0;

                // Remove previous winner classes
                bracketBox.classList.remove('winner-a', 'winner-b');

                // Highlight the winner
                if (teamAScore > teamBScore) {
                    bracketBox.classList.add('winner-a');
                } else if (teamBScore > teamAScore) {
                    bracketBox.classList.add('winner-b');
                }
            });

            // Dynamically update the final winner box
            updateFinalWinner();
        }







        function updateFinalWinner() {
            const finalBox = document.querySelector('.round.final .bracketbox.winner .team-name');
            const trophyIcon = document.querySelector('.round.final .bracketbox.winner .trophy');

            if (!finalBox) {
                console.error('Final winner box not found!');
                return;
            }

            // Get the final match bracket (the last round's first match)
            const finalRound = transformedStructure[transformedStructure.length - 1]; // Last round
            if (!finalRound || finalRound.length === 0) {
                console.warn('No matches in the final round!');
                finalBox.textContent = 'No Winner';
                trophyIcon.style.display = 'none'; // Hide trophy if no winner
                return;
            }

            const finalMatch = finalRound[0]; // Assuming one match in the final round
            if (!finalMatch || !finalMatch.teamA || !finalMatch.teamB) {
                console.warn('Incomplete final match data!');
                finalBox.textContent = 'No Winner';
                trophyIcon.style.display = 'none'; // Hide trophy if no winner
                return;
            }

            // Get scores directly from the inputs in the DOM
            const teamAElement = document.querySelector(
                `.bracketbox[data-round="${finalMatch.roundNo}"][data-bracket-no="${finalMatch.bracketNo}"] .team-a`
            );
            const teamBElement = document.querySelector(
                `.bracketbox[data-round="${finalMatch.roundNo}"][data-bracket-no="${finalMatch.bracketNo}"] .team-b`
            );

            if (!teamAElement || !teamBElement) {
                console.warn('Missing final match DOM elements!');
                finalBox.textContent = 'No Winner';
                trophyIcon.style.display = 'none'; // Hide trophy if no winner
                return;
            }

            const teamAScore = parseInt(teamAElement.querySelector('.team-score').value) || 0;
            const teamBScore = parseInt(teamBElement.querySelector('.team-score').value) || 0;

            const winner =
                teamAScore > teamBScore
                    ? teamAElement.querySelector('.team-name').textContent
                    : teamBElement.querySelector('.team-name').textContent;

            // Update the final winner box dynamically
            finalBox.textContent = winner || 'No Winner';
            trophyIcon.style.display = winner ? 'inline' : 'none';
        }



        


        

