            function generateBracket(players) {
                console.log('generateBracket called with players:', players); // Debugging log
                if (!players || players.length < 2) {
                    alert('تعداد بازیکنان کافی نیست.');
                    return;
                }

                const totalPlayers = Math.pow(2, Math.ceil(Math.log2(players.length)));
                console.log('Total players normalized to:', totalPlayers);

                const normalizedPlayers = players.map(player =>
                    typeof player === 'string' ? { name: player } : player
                );

                while (normalizedPlayers.length < totalPlayers) {
                    normalizedPlayers.push({ name: '' });
                }

                currentStruct = getBracket(totalPlayers, normalizedPlayers);
                console.log('Generated bracket structure:', currentStruct); // Debugging log
                document.getElementById('brackets').innerHTML = '';
                renderBrackets(currentStruct, false); // Call the renderBrackets function
            }



            function getBracket(playerCount, players) {

                const totalPlayers = Math.pow(2, Math.ceil(Math.log2(playerCount)));

                let brackets = [];
                let round = 1;
                let baseT = totalPlayers / 2;
                let baseC = totalPlayers / 2;
                let nextInc = totalPlayers / 2;


                const normalizedPlayers = [...players];
                while (normalizedPlayers.length < totalPlayers) {
                    normalizedPlayers.push({ name: '' });
                }

                for (let i = 1; i <= (totalPlayers - 1); i++) {
                    let baseR = i / baseT;

                    let last = brackets.filter(b => b.nextGame == i).map(b => ({ game: b.bracketNo, teams: b.teamnames }));

                    brackets.push({
                        lastGames: round == 1 ? null : [last[0]?.game, last[1]?.game],
                        nextGame: nextInc + i > totalPlayers - 1 ? null : nextInc + i,
                        teamnames: round === 1
                            ? [
                                normalizedPlayers[i * 2 - 2]?.name || '',
                                normalizedPlayers[i * 2 - 1]?.name || ''
                            ]
                            : ['', ''],
                        bracketNo: i,
                        roundNo: round,
                        scores: [0, 0]
                    });

                    if (i % 2 != 0) nextInc--;
                    while (baseR >= 1) {
                        round++;
                        baseC /= 2;
                        baseT = baseT + baseC;
                        baseR = i / baseT;
                    }
                }

                return brackets;
            }




            function renderBrackets(struct, isFromDatabase = false) {
