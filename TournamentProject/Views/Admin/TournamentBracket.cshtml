            function dynamicChange() {
                console.log("Dynamic change initiated. Checking all brackets...");

                // Get all `.bracketbox` elements
                let boxes = document.querySelectorAll('.bracketbox');
                if (boxes.length === 0) {
                    console.warn("No bracket boxes found! Check if brackets are rendered correctly.");
                    return; // Exit if no bracket boxes exist
                }

                // Calculate the maximum number of rounds
                let maxRounds = Math.max(
                    ...Array.from(boxes).map(box => parseInt(box.dataset.round) || 0)
                );
                console.log("Max Rounds:", maxRounds);

                // Start from Round 1 and propagate winners to all subsequent rounds
                for (let round = 1; round <= maxRounds; round++) {
                    document.querySelectorAll(`.bracketbox[data-round="${round}"]`).forEach((bracketBox) => {
                        
                        let scoreA = parseInt(bracketBox.querySelector('.team-a .team-score')?.value || 0);
                        let scoreB = parseInt(bracketBox.querySelector('.team-b .team-score')?.value || 0);
                        

                        if (scoreA !== '' && scoreB !== '') {
                            // Update the bracket and propagate winners
                            updateBracket(bracketBox);
                        }
                    });
                }
            }









            function checkAndEnableNextRound(currentRound) {
                let allScoresEntered = true;
                document.querySelectorAll(`.bracketbox[data-round="${currentRound}"]`).forEach(box => {
                    let score1 = box.querySelector('.team-score[data-team="0"]').value;
                    let score2 = box.querySelector('.team-score[data-team="1"]').value;
                    if (score1 === '' || score2 === '') {
                        allScoresEntered = false;
                    }
                });

                if (allScoresEntered) {
                    document.querySelectorAll(`.bracketbox[data-round="${currentRound + 1}"] .team-score`).forEach(input => {
                        input.disabled = false;
                    });
                }
            }


            function printBracket() {
                window.print();
            }



            document.getElementById('viewTablesButton').addEventListener('click', function () {
                fetch('/Admin/GetSavedTournaments')
                    .then(response => {
                        if (!response.ok) throw new Error('Failed to fetch tournaments');
                        return response.json();
                    })
                    .then(tournaments => {
                        console.log('Saved tournaments:', tournaments); // Debugging log to inspect response

                        const tournamentList = document.getElementById('savedTournaments');
                        tournamentList.innerHTML = ''; // Clear existing content

                        tournaments.forEach(tournament => {
                            if (!tournament.tournamentName) {
                                console.warn('Missing tournamentName for:', tournament); // Log any missing names
                            }

                            const listItem = document.createElement('li');
                            listItem.className = 'list-group-item d-flex justify-content-between align-items-center';

                            // Add the tournament name
                            const tournamentNameSpan = document.createElement('span');
                            tournamentNameSpan.textContent = tournament.tournamentName || 'Unknown Tournament'; // Fallback for missing names
                            tournamentNameSpan.style.flexGrow = '1'; // Ensure proper alignment

                            // Add the button to load the tournament
                            const loadButton = document.createElement('button');
                            loadButton.className = 'btn btn-primary btn-sm';
                            loadButton.textContent = 'بارگذاری جدول';
                            loadButton.addEventListener('click', () => {
                                loadTournament(tournament.tournamentName);
                            });

                            // Add the button to delete the tournament
                            const deleteButton = document.createElement('button');
                            deleteButton.className = 'btn btn-danger btn-sm ms-2'; // Add spacing between buttons
                            deleteButton.textContent = 'حذف';
                            deleteButton.addEventListener('click', () => {
                                deleteTournament(tournament.tournamentName);
                            });

                            // Append elements to the list item
                            listItem.appendChild(tournamentNameSpan);
                            listItem.appendChild(loadButton);
                            listItem.appendChild(deleteButton);

                            // Append the list item to the modal
                            tournamentList.appendChild(listItem);
                        });
                    })
                    .catch(error => console.error('Error fetching tournaments:', error));
            });


            function loadTournament(tournamentName) {
                fetch(`/Admin/LoadTournament?tournamentName=${encodeURIComponent(tournamentName)}`)
                    .then(response => {
                        if (!response.ok) throw new Error('Failed to load tournament');
                        return response.json();
                    })
                    .then(tournamentData => {
                        console.log('Loaded tournament data:', tournamentData);

                        // Use the fetched data to generate the bracket
                        currentStruct = tournamentData;
                        renderBrackets(currentStruct, true);

                        // Show the save button
                        document.getElementById('saveBracketButton').style.display = 'block';
                    })
                    .catch(error => {
                        console.error('Error loading tournament:', error);
                        alert('Failed to load tournament.');
                    });
            }



            document.getElementById('viewTablesButton').addEventListener('click', function () {
                const modal = new bootstrap.Modal(document.getElementById('bracketModal'));
                modal.show();
            });






        });





        function deleteTournament(tournamentName) {
            if (!confirm(`آیا از حذف جدول '${tournamentName}' اطمینان دارید؟`)) {
                return; // Exit if the user cancels the confirmation dialog
            }

            const requestData = {
                TournamentName: tournamentName
            };

            fetch('/Admin/DeleteTournament', {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(requestData)
            })
                .then(response => {
                    if (!response.ok) {
                        return response.json().then(error => {
                            console.error('Error deleting tournament:', error);
                            throw new Error(error.message || 'Unknown error');
                        });
                    }
                    return response.json();
                })
                .then(result => {
                    alert(result.message);
                    // Reload the tournament list to reflect changes
                    document.getElementById('viewTablesButton').click();
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert(`حذف جدول شکست خورد: ${error.message}`);
                });
        }



