                        if (box.classList.contains('winner')) {
                            console.log('Skipping final winner box:', box);
                            return;
                        }
                        
                        const scoreAInput = box.querySelector('.team-score[data-team="0"]');
                        const scoreBInput = box.querySelector('.team-score[data-team="1"]');

                        if (!scoreAInput || !scoreBInput) {
                            console.warn('Skipping intermediate bracket box due to missing team-score inputs:', {
                                box: box,
                                innerHTML: box.innerHTML,
                            });
                            return;
                        }

                        const scoreA = scoreAInput.value || 0;
                        const scoreB = scoreBInput.value || 0;

                        if (scoreA !== '' && scoreB !== '') {
