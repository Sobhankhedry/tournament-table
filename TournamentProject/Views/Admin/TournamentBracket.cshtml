        function enableNextRoundIfComplete(currentRound) {
            const allScoresEntered = Array.from(
                document.querySelectorAll(`.bracketbox[data-round="${currentRound}"]`)
            ).every(box => {
                const scoreA = box.querySelector('.team:nth-child(1) .team-score').value;
                const scoreB = box.querySelector('.team:nth-child(2) .team-score').value;
                return scoreA !== '' && scoreB !== '';
            });

            if (allScoresEntered) {
                document.querySelectorAll(`.bracketbox[data-round="${currentRound + 1}"] .team-score`).forEach(input => {
                    input.disabled = false;
                });
            }
        }


