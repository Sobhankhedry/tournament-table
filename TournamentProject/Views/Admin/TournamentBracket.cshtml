            function updateBracket(bracketBox) {
                // Get the current bracket number and round number
                let bracketNo = parseInt(bracketBox.dataset.bracketNo);
                let roundNo = parseInt(bracketBox.dataset.round);

                console.log(`Updating Bracket: No = ${bracketNo}, Round = ${roundNo}`);

                let scores = [
                    parseInt(bracketBox.querySelector('.team-a .team-score')?.value || 0),
                    parseInt(bracketBox.querySelector('.team-b .team-score')?.value || 0),
                ];

                // Check for a tie
                if (scores[0] === scores[1]) {
                    // Remove highlighting in case of a tie
                    bracketBox.classList.remove('winner-a', 'winner-b');
                    console.log(`Bracket ${bracketNo}, Round ${roundNo} - Tie detected! No winner.`);
                    return; // Stop here as there's no winner to propagate
                }

                // Determine the winner
                let winner = scores[0] > scores[1] ? 0 : 1;

                // Highlight the winner in the current box
                bracketBox.classList.remove('winner-a', 'winner-b');
                bracketBox.classList.add(winner === 0 ? 'winner-a' : 'winner-b');

                console.log(`Bracket ${bracketNo}, Round ${roundNo} - Winner is Team ${winner === 0 ? 'A' : 'B'} with scores [${scores[0]}-${scores[1]}]`);

                // Calculate the next bracket number
                let nextBracketNo = null;
                if (roundNo === 1) {
                    // Round 1 → Round 2
                    nextBracketNo = 4 + Math.floor((bracketNo + 1) / 2);
                } else if (roundNo === 2) {
                    // Round 2 → Round 3 (Final)
                    nextBracketNo = 7; // Both Bracket 5 and Bracket 6 feed into Bracket 7
                }

                console.log(`Looking for Next Bracket: Round ${roundNo + 1}, No ${nextBracketNo}`);

                // Find the next bracket in the DOM
                let nextBracketBox = document.querySelector(
                    `.bracketbox[data-round="${roundNo + 1}"][data-bracket-no="${nextBracketNo}"]`
                );

                if (nextBracketBox) {
                    let winnerPosition = (bracketNo % 2 === 0) ? 2 : 1; // Even → Team B, Odd → Team A
                    let winnerName = bracketBox.querySelector(`.team:nth-child(${winner + 1}) .team-name`).textContent;

                    console.log(`Propagating winner (${winnerName}) to Bracket ${nextBracketNo} in Round ${roundNo + 1} at Position ${winnerPosition}`);
                    nextBracketBox.querySelector(`.team:nth-child(${winnerPosition}) .team-name`).textContent = winnerName;

                    updateBracket(nextBracketBox); // Recursively update the next bracket
                } else {
                    console.warn(`No nextBracketBox found for Bracket ${bracketNo} in Round ${roundNo}`);
                }

                if (!document.querySelector(`.bracketbox[data-round="${roundNo + 1}"]`)) {
                    let finalWinner = bracketBox.querySelector(`.team:nth-child(${winner + 1}) .team-name`).textContent;
                    document.querySelector('.final .team-name').textContent = finalWinner;

                    console.log(`Final winner updated: ${finalWinner}`);
                }
            }





