            function propagateWinnersToNextRounds(brackets) {
                for (let i = 0; i < brackets.length - 1; i++) {
                    const currentRoundMatches = brackets.filter(m => m.roundNo === i + 1);
                    const nextRoundMatches = brackets.filter(m => m.roundNo === i + 2);

                    currentRoundMatches.forEach(currentMatch => {
                        const [scoreA, scoreB] = currentMatch.scores;
                        const winner = scoreA > scoreB ? currentMatch.teamnames[0] : currentMatch.teamnames[1];

                        // Find the match in the next round that corresponds to this game's `nextGame`
                        const nextMatch = nextRoundMatches.find(m => m.bracketNo === currentMatch.nextGame);
                        if (nextMatch) {
                            const teamIndex = nextMatch.lastGames.indexOf(currentMatch.bracketNo);
                            if (teamIndex === 0) {
                                nextMatch.teamnames[0] = winner;
                            } else if (teamIndex === 1) {
                                nextMatch.teamnames[1] = winner;
                            }
                        }
                    });
                }
            }





