<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Styled Page</title>
    <link rel="stylesheet" href="/css/coach.css">
</head>
<body>
    <div class="container">
        <header>
            <nav>
                <a asp-controller="Home" asp-action="Index" class="btn text-decoration-none">بازگشت</a>
                <button class="btn">جدول مسابقات</button>
            </nav>
        </header>

        <main>
            <section class="search-section">
                <div class="search-container">
                    <input type="search" id="query" placeholder="جستجو...">
                    <button class="btn btn-search">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M21.53 20.47l-3.66-3.66C19.195 15.24 20 13.214 20 11c0-4.97-4.03-9-9-9s-9 4.03-9 9 4.03 9 9 9c2.215 0 4.24-.804 5.808-2.13l3.66 3.66c.147.146.34.22.53.22s.385-.073.53-.22c.295-.293.295-.767.002-1.06zM3.5 11c0-4.135 3.365-7.5 7.5-7.5s7.5 3.365 7.5 7.5-3.365 7.5-7.5 7.5-7.5-3.365-7.5-7.5z"></path>
                        </svg>
                    </button>
                </div>
            </section>

            <section class="content">
                <div class="sidebar">
                    <button class="button2">نام مربی</button>
                    <div class="card">
                        <p><span data-age-group="نو نهالان">نونهالان</span></p>
                        <p><span data-age-group="نوجوانان">نوجوانان</span></p>
                        <p><span data-age-group="جوانان">جوانان</span></p>
                        <p><span data-age-group="بزرگسالان">بزرگسالان</span></p>
                    </div>
                </div>

                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>وزن</th>                                
                                <th>نام خانوادگی</th>
                                <th>نام</th>
                            </tr>
                        </thead>
                         <tbody>

                        </tbody>
                    </table>
                </div>
            </section>
        </main>
    </div>

    <script>
        document.querySelectorAll('.card span').forEach(category => {
            category.addEventListener('click', () => {
                const ageGroup = category.getAttribute('data-age-group'); // Get the clicked age group
                const managerName = document.querySelector('.button2').innerText.trim(); // Get the manager's name

                console.log(`Fetching players for manager: ${managerName}, Age Group: ${ageGroup}`);

                // Construct the API endpoint URL
                const apiUrl = `/Admin/GetPlayersByManagerAndAgeGroup?managerName=${encodeURIComponent(managerName)}&ageGroup=${encodeURIComponent(ageGroup)}`;

                // Fetch players for the selected manager and age group
                fetch(apiUrl)
                    .then(response => {
                        if (!response.ok) {
                            throw new Error(`HTTP error! status: ${response.status}`);
                        }
                        return response.json();
                    })
                    .then(data => {
                        
                        // Select the table body
                        const tbody = document.querySelector('.table-container table tbody');
                        if (!tbody) {
                            console.error("Table <tbody> element not found in the DOM");
                            return;
                        }

                        // Clear existing table rows
                        tbody.innerHTML = '';

                        // Populate the table with new player data
                        data.forEach(player => {
                            const row = document.createElement('tr');
                            row.innerHTML = `
                                
                               
                                <td>${player.weigh}</td>
                                        <td>${player.lastName}</td>
                                         <td>${player.name}</td>
                            `;
                            tbody.appendChild(row);
                        });
                    })
                    .catch(error => {
                        console.error("Failed to fetch players:", error);
                        alert('Failed to fetch players. Please try again.');
                    });
            });
        });




        window.addEventListener('DOMContentLoaded', () => {
            fetch('/Admin/GetLoggedInManagerName')
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json(); 
                })
                .then(data => {
                    console.log("Response Data:", data); 
                    const managerButton = document.querySelector('.button2');
                    managerButton.innerText = data.name || "نام نامشخص"; 
                })
                .catch(error => {
                    console.error("Failed to fetch manager's name:", error);
                    const managerButton = document.querySelector('.button2');
                    managerButton.innerText = "نام نامشخص"; 
                });

        });


        document.getElementById("query").addEventListener("input", function () {
            const query = this.value.toLowerCase();
            const rows = document.querySelectorAll("tbody tr"); 

            rows.forEach(row => {
                const cells = row.querySelectorAll("td"); 
                let rowText = ""; 

                cells.forEach(cell => {
                    rowText += cell.textContent.toLowerCase() + " "; 
                });

                
                if (rowText.includes(query)) {
                    row.style.display = "";
                } else {
                    row.style.display = "none"; 
                }
            });
        });

        


    </script>
</body>
</html>
