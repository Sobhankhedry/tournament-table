<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/weigh-in.css">
    <link rel="stylesheet" href="css/bootstrap.fa.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


    <title>Weigh In System</title>
    <style>
        .content {
          display: flex;
          flex-wrap: wrap;
          gap: 20px;
        }
        .cards-and-table {
          flex: 2;
        }
        .form {
          flex: 1;
        }
    </style>
</head>
<body>
    <div class="container">
        

         
        <div class="main">
            

            <div class="content">

                <div class="cards-and-table">
                    <div class="cards">
                        <div class="card red" data-age-group="نونهالان">
                            <p class="tip">نونهالان</p>
                        </div>
                        <div class="card blue" data-age-group="نوجوانان">
                            <p class="tip">نوجوانان</p>
                        </div>
                        <div class="card green" data-age-group="جوانان">
                            <p class="tip">جوانان</p>
                        </div>
                        <div class="card red" data-age-group="بزرگسالان">
                            <p class="tip">بزرگسالان</p>
                        </div>
                    </div>

                    <div class="table-container" style=" height:300px; overflow-y:auto; overflow-x:hidden">
                        @* search section *@
                        <div class="group">
                            <svg viewBox="0 0 24 24" aria-hidden="true" class="search-icon">
                                <g>
                                    <path d="M21.53 20.47l-3.66-3.66C19.195 15.24 20 13.214 20 11c0-4.97-4.03-9-9-9s-9 4.03-9 9 4.03 9 9 9c2.215 0 4.24-.804 5.808-2.13l3.66 3.66c.147.146.34.22.53.22s.385-.073.53-.22c.295-.293.295-.767.002-1.06zM3.5 11c0-4.135 3.365-7.5 7.5-7.5s7.5 3.365 7.5 7.5-3.365 7.5-7.5 7.5-7.5-3.365-7.5-7.5z"></path>
                                </g>
                            </svg>

                            <input id="query"
                                   class="input-search"
                                   type="search"
                                   placeholder="جستجو "
                                   name="searchbar" />
                        </div>

                        <table class="info-table">
                            <thead>
                                <tr>
                                    <th>رده سنی</th>
                                    <th>نام مربی</th>
                                    <th>وزن</th>
                                    <th>جنسیت</th>
                                    <th>نام و نام خانوادگی</th>
                                </tr>
                            </thead>
                            <tbody>

                            </tbody>
                        </table>

                    </div>
                    <button class="edit">ویرایش</button>

                </div>


                <form class="form" asp-controller="Admin" asp-action="WeighIn" method="post" dir="rtl">
                    <p class="title">مشخصات </p>
                    <p class="message" dir="auto">لطفا اطلاعات خود را وارد کنید </p>
                    <div class="flex">
                        <div class="flex">
                            <label dir="rtl">
                                <span class="name">نام</span>
                                <input class="input" id="FirstName" name="FirstName" type="text" placeholder="نام" required>
                                
                            </label>
                            <label >
                                <span class="lastname">نام خانوادگی</span>
                                <input class="input " id="LastName" name="LastName" type="text" placeholder="نام خانوادگی" required>
                                
                            </label>
                        </div>
                    </div>
                    <div style="display: flex; gap: 20px; margin-bottom: 20px; align-items: flex-start;">
                        <!-- Gender -->
                        <div style="flex: 1; display: flex; flex-direction: column;">
                            <label for="gender" style="margin-bottom: 8px; font-size: 14px; font-weight: bold; color: #fff; text-align: right;">
                                جنسیت
                            </label>
                            <select id="gender" name="Gender" style="padding: 10px; font-size: 16px; direction: rtl; background-color: #333; color: white; border: 1px solid rgba(105, 105, 105, 0.397); border-radius: 10px; box-sizing: border-box;">
                                <option value="">انتخاب کنید</option>
                                <option value="male">مرد</option>
                                <option value="female">زن</option>
                            </select>
                        </div>

                        <!-- Weight -->
                        <div style="flex: 1; display: flex; flex-direction: column;">
                            <label for="weigh" style="margin-bottom: 8px; font-size: 14px; font-weight: bold; color: #fff; text-align: right;">
                                وزن
                            </label>
                            <input id="Weigh" name="Weigh" type="number" placeholder="وزن خود را وارد کنید"
                                   style="padding: 10px; font-size: 16px; direction: rtl; background-color: #333; color: white; border: 1px solid rgba(105, 105, 105, 0.397); border-radius: 10px; box-sizing: border-box;">
                        </div>
                    </div>

                    

                    <label>
                        <span class="birth">تاریخ تولد</span>
                        <div class="birth-dropdowns">
                            <select class="input year" name="Year" required dir="rtl">
                                <option value="" disabled selected>سال</option>
                                <script>
                                    for (let i = 1404; i >= 1360; i--) {
                                        document.write(`<option value="${i}">${i}</option>`);
                                    }
                                </script>
                            </select>
                            <select class="input month" name="Month" required dir="rtl">
                                <option value="" disabled selected>ماه</option>
                                <option value="1">فروردین</option>
                                <option value="2">اردیبهشت</option>
                                <option value="3">خرداد</option>
                                <option value="4">تیر</option>
                                <option value="5">مرداد</option>
                                <option value="6">شهریور</option>
                                <option value="7">مهر</option>
                                <option value="8">آبان</option>
                                <option value="9">آذر</option>
                                <option value="10">دی</option>
                                <option value="11">بهمن</option>
                                <option value="12">اسفند</option>
                            </select>
                            <select class="input day" name="Day" required dir="rtl">
                                <option value="" disabled selected>روز</option>
                                <script>
                                    for (let i = 1; i <= 31; i++) {
                                        document.write(`<option value="${i}">${i}</option>`);
                                    }
                                </script>
                            </select>
                        </div>
                        
                    </label>

                    <!-- Coach Name Field -->
                    <span class="coach">نام مربی</span>
                    <select class="input-coach" id="managersContainer" required="" name="Coach" onfocus="loadManagers(this)">
                        
                        <option value="" disabled selected>انتخاب کنید</option>
                    </select>
                    
                    <button class="submit" dir="rtl" type="submit">ثبت</button>
                </form>


            </div>
        </div>
    </div>
    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                // Display the alert with the message stored in TempData
                alert('@Html.Raw(TempData["SuccessMessage"])');

                // Clear all input fields
                const inputs = document.querySelectorAll('input');
                inputs.forEach(input => {
                    input.value = '';
                });

                // Clear textareas if needed
                const textareas = document.querySelectorAll('textarea');
                textareas.forEach(textarea => {
                    textarea.value = '';
                });

                // Reset dropdowns (if any)
                const selects = document.querySelectorAll('select');
                selects.forEach(select => {
                    select.selectedIndex = 0;
                });
            });
        </script>
    }

    <script>
        document.querySelectorAll('.card').forEach(card => {
            card.addEventListener('click', function () {
                const ageGroup = this.getAttribute('data-age-group');

               
                fetch('/Admin/FetchPlayers?ageGroup=' + encodeURIComponent(ageGroup))
                    .then(response => response.json())
                    .then(data => {
                        
                        const tbody = document.querySelector('.info-table tbody');
                        tbody.innerHTML = ''; 

                        data.forEach((player, index) => {
                            console.log(player);
                            
                            const row = document.createElement('tr');
                            row.setAttribute('data-id', player.id);
                            row.innerHTML = `
                                <td>${player.age}</td>
                                <td>${player.managerName}</td>
                                <td>${player.weigh}</td>
                                <td>${player.gender}</td>
                                <td>${player.name + " " + player.lastName}</td>
                                <td>
                                    <button class="edit-button"
                                        data-index="${index}"
                                        data-group="${ageGroup}">
                                        ویرایش
                                    </button>
                                </td>
                            `;
                            tbody.appendChild(row);
                        });

                        
                        addEditListeners();
                    })
                    .catch(error => console.error('Error:', error));
            });
        })
       

        function loadManagers(selectElement) {
           
            if (selectElement.options.length > 2) {
                return; 
            }

            
            $.ajax({
                url: '@Url.Action("GettingManagers", "Admin")',
                type: 'GET',
                success: function (data) {
                    if (data.length > 0) {
                       
                        const options = data.map(manager => `<option value="${manager}">${manager}</option>`).join('');
                        selectElement.innerHTML = '<option value="" disabled>انتخاب کنید</option>' + options;
                    } else {
                        selectElement.innerHTML = '<option value="" disabled>هیچ مربی موجود نیست</option>';
                    }
                },
                error: function () {
                    alert('Failed to load managers.');
                    selectElement.innerHTML = '<option value="" disabled>خطا در بارگذاری</option>';
                }
            });
        }



        document.getElementById('query').addEventListener('input', function () {
            const query = this.value.toLowerCase();
            const rows = document.querySelectorAll('.info-table tbody tr');

            rows.forEach(row => {
                const cells = row.querySelectorAll('td');
                let rowText = '';
                cells.forEach(cell => {
                    rowText += cell.textContent.toLowerCase() + ' ';
                });

                if (rowText.includes(query)) {
                    row.style.display = ''; 
                } else {
                    row.style.display = 'none'; 
                }
            });
        });


        function addEditListeners() {
            document.querySelectorAll(".edit-button").forEach((button) => {
                button.addEventListener("click", (e) => {
                    const index = button.getAttribute("data-index");
                    const group = button.getAttribute("data-group");
                    
                    const row = button.closest('tr');
                    const id = row.getAttribute('data-id');
                    
                    const modal = createEditModal({
                        id: id,
                        name: row.querySelector('td:nth-child(5)').innerText.split(' ')[0],
                        lastName: row.querySelector('td:nth-child(5)').innerText.split(' ')[1],
                        weigh: row.querySelector('td:nth-child(3)').innerText,
                        gender: row.querySelector('td:nth-child(4)').innerText,
                        coach: row.querySelector('td:nth-child(2)').innerText,
                    }, group, index);
                    
                    document.body.appendChild(modal);
                });
            });
        }

        // Create an edit modal
        function createEditModal(row, group, index) {
            
            const modal = document.createElement("div");
            modal.classList.add("modal");
            modal.innerHTML = `
            <div class="modal-content">
                <h3>ویرایش اطلاعات</h3>
                <label>نام: <input type="text" id="edit-name" value="${row.name}" required /></label>
                <label>نام خانوادگی: <input type="text" id="edit-lastName" value="${row.lastName}" required /></label>
                <label>وزن: <input type="number" id="edit-weight" value="${row.weigh}" required /></label>
                <label>جنسیت:
                    <select id="edit-gender" required>
                        <option value="مرد" ${row.gender === "مرد" ? "selected" : ""}>مرد</option>
                        <option value="زن" ${row.gender === "زن" ? "selected" : ""}>زن</option>
                    </select>
                </label>
                <label>نام مربی:
                    <select id="edit-coach" onfocus="loadManagers(this)" required>
                        <option value="" disabled selected>انتخاب کنید</option>
                    </select>
                </label>
                <button id="save-button">ذخیره</button>
                <button id="delete-button">حذف</button>
                <button id="close-button">بستن</button>
            </div>
        `;


            
            modal.querySelector("#close-button").addEventListener("click", () => {
                modal.remove();
            });

            
            modal.querySelector("#save-button").addEventListener("click", () => {
                const inputs = modal.querySelectorAll("input, select");
                let isValid = true;

                inputs.forEach((input) => {
                    if (!input.checkValidity()) {
                        isValid = false;
                        input.reportValidity(); 
                    }
                });

                if (!isValid) {
                    return;
                }

                const updatedRow = {
                    id: row.id,
                    name: modal.querySelector("#edit-name").value,
                    lastName: modal.querySelector("#edit-lastName").value,
                    weigh: modal.querySelector("#edit-weight").value,
                    gender: modal.querySelector("#edit-gender").value,
                    managerName: modal.querySelector("#edit-coach").value,
                };
                alert("before fetch")
                console.log("Updated Row Data:", updatedRow);
                
                fetch('/Admin/UpdatePlayer', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json', 
                    },
                    body: JSON.stringify(updatedRow),
                    
                })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error(`HTTP error! status: ${response.status}`);
                        }
                        return response.json();
                    })
                    .then(data => {
                        console.log("Update Successful:", data);
                        alert('Player updated successfully!');


                        const rowElement = document.querySelector(`tr[data-id="${updatedRow.id}"]`);
                        if (rowElement) {
                            rowElement.querySelector('td:nth-child(2)').innerText = updatedRow.managerName; 
                            rowElement.querySelector('td:nth-child(3)').innerText = updatedRow.weigh;       
                            rowElement.querySelector('td:nth-child(4)').innerText = updatedRow.gender;      
                            rowElement.querySelector('td:nth-child(5)').innerText = `${updatedRow.name} ${updatedRow.lastName}`; 
                        }

                        
                        modal.remove(); 
                    })
                    .catch(error => {
                        console.error("Update Failed:", error);
                        alert('Failed to update player. Please try again.');
                    });
            });


            
            modal.querySelector("#delete-button").addEventListener("click", () => {
                console.log("Delete row:", index, group);
                
                modal.remove();
            });

            return modal;
        }
        
        document.addEventListener('DOMContentLoaded', function () {
            const selectElement = document.getElementById('edit-coach');
            loadManagers(selectElement);
        });

        


    </script>

    
</body>
</html>
