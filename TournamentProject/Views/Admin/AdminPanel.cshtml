    <!-- Modal for Feedback -->
<div class="modal fade" id="feedbackModal" tabindex="-1" aria-labelledby="feedbackModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-light">
            <div class="modal-header">
                <h5 class="modal-title" id="feedbackModalLabel">نظر کامل</h5>
                <button type="button" class="btn btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modalFeedbackContent">
                <!-- Feedback Description will be dynamically inserted here -->
            </div>
        </div>
    </div>
</div>
    

    <script>
        function addRow(tableId) {
            if (checkEmptyFields(tableId)) {
                alert('لطفاً ابتدا فیلد قبلی را پر کنید.');
                return;
            }
            
            const table = document.getElementById(tableId);
            const newRow = table.insertRow();
            const cell1 = newRow.insertCell(0);
            const cell2 = newRow.insertCell(1);
            
            cell1.innerHTML = '<input type="text" class="form-control bg-dark text-white" onchange="updateMainPage(this)">';
            cell2.innerHTML = '<button class="btn btn-danger btn-sm" onclick="deleteRow(this)">حذف</button>';
        }


        function checkEmptyFields(tableId) {
            const table = document.getElementById(tableId);
            const inputs = table.getElementsByTagName('input');
            for (let i = 0; i < inputs.length; i++) {
                if (inputs[i].value.trim() === '') {
                    return true; 
                }
            }
            return false;
        }



        function deleteRow(btn) {
            const row = btn.parentNode.parentNode;
            row.parentNode.removeChild(row);
            updateMainPage();
        }


        function saveTableData(tableId, endpoint) {
            const table = document.getElementById(tableId);
            const rows = table.rows;
            const data = [];
            if (rows.id == 1) {
                alert('found you')
            }
            if (endpoint == '/Admin/SaveTeams')
            {
               
                for (let i = 0; i < rows.length; i++) {
                    
                    const input = rows[i].cells[1].querySelector("input");
                    if (!input) {
                        continue;
                    }

                    const value = input.value.trim();
                    if (value === "") {
                        alert("وارد کردن تمامی فیلد ها الزامی است");
                        return;
                    }
                    

                    data.push(value);


                    fetch(endpoint, { 
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(data)
                        })
                        .then(response => response.json())
                        .then(result => {
                            if (result.success) {
                            alert("اطلاعات با موفقیت ذخیره شدند");
                            location.reload(); 
                            } else {
                                // alert("خطا: " + result.message);
                            }
                            })
                            // .catch(error => console.error("Error:", error));
                            }
                    return;
              }
                       
                
           
            // Collect data from each row
            for (let i = 0; i < rows.length; i++) {
                const input = rows[i].cells[0].querySelector("input");
                if (input) {
                    const value = input.value.trim();
                    if (value) {
                        
                        data.push(value); 
                    }
                }
            }

            if (data.length === 0) {
                alert("هیچ داده‌ای برای ذخیره وجود ندارد."); 
                return;
            }

            fetch(endpoint, { 
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
                .then(response => response.json())
                .then(result => {
                    if (result.success) {
                        alert("اطلاعات با موفقیت ذخیره شدند");
                        location.reload(); 
                    } else {
                        alert("خطا: " + result.message);
                    }
                })
                .catch(error => console.error("Error:", error));
        }
        

        function updateMainPage(input) {
            if (input) {
                console.log('Updated value:', input.value);
            } else {
                console.log('Row deleted, update main page');
            }
        }

        function saveAllTableData(tableId, url) {
            const medalsData = [];            
            const inputs = document.querySelectorAll('input[id^="teenMedal-"], input[id^="juniorMedal-"], input[id^="youthMedal-"], input[id^="adultMedal-"]'); // Select all inputs starting with the category identifiers
            inputs.forEach(input => {
                
                const idParts = input.id.split('-'); 
                const age = idParts[0].replace('Medal', ''); 
                const place = idParts[1];
                const weight = idParts[2]; 
                if(!input.value.trim())
                {
                    console.warn('Empty value for input:', input.id);
                    return;
                }
                const medalData = {
                    Weight: weight, 
                    Name: input.value, 
                    Age: age, 
                    Place: place 
                };
                medalsData.push(medalData);
            });

            if(medalsData.length==0){
                alert('هیج فیلدی برای دریافت اطلاعات وجود ندارد')
                return;
            }else{
                sendMedalDataToBackend(medalsData);
            }
            
        }

        function sendMedalDataToBackend(medalsData) {
            fetch('/Admin/SaveMedals', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(medalsData), 
            })
                .then(response => {
          if (!response.ok) {
                throw new Error('HTTP error! Status: ' + response.status);
            }
            return response.json();
            })
                .then(data => {
                    if (data.success) {
                        alert('اطلاعات با موفقیت ذخیره شدند');
                        location.reload();
                    } else {
                        alert('خطایی در ذخیره پیش آمد');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred while saving medal data.');
                });
            
        }

        document.addEventListener('DOMContentLoaded', function () {
            fetch('/Admin/GetMedals', {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json',
                },
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('HTTP error! Status: ' + response.status);
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        populateInputs(data.data);
                    } else {
                        alert('Error retrieving medal data.');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred while retrieving medal data.');
                });
        });

        function populateInputs(medalsData) {
            medalsData.forEach(medal => {
                console.log('Medal Data:', medal); 
                const inputId = `${medal.age}Medal-${medal.place}-${medal.weight}`;
                console.log('Generated Input ID:', inputId); 
                const inputElement = document.getElementById(inputId);
                if (inputElement) {
                    inputElement.value = medal.name; 
                    console.log(`Input ${inputId} found and updated with value: ${medal.name}`);
                } else {
                    console.warn('Input element not found for:', inputId);
                }
            });
        }

        


        

        document.getElementById("coachesModal").addEventListener("shown.bs.modal", function () {
            fetch('/Admin/GetCoaches')
                .then(response => response.json())
                .then(coaches => {
                    const tableBody = document.getElementById("coachesTable");
                    tableBody.innerHTML = ""; 

                    coaches.forEach(coach => {
                        const newRow = tableBody.insertRow();
                        const cell1 = newRow.insertCell(0);
                        const cell2 = newRow.insertCell(1);
                        cell1.innerHTML = `<input type="text" class="form-control bg-dark text-white" value="${coach}">`;
                        cell2.innerHTML = '<button class="btn btn-danger btn-sm" onclick="deleteRow(this)">حذف</button>';
                    });
                })
                .catch(error => console.error("Error fetching coaches:", error));
        });

        document.getElementById("refereesModal").addEventListener("shown.bs.modal", function () {
            fetch('/Admin/GetReferees')
                .then(response => response.json())
                .then(referees => {
                    const tableBody = document.getElementById("refereesTable");
                    tableBody.innerHTML = ""; 

                    referees.forEach(referee => {
                        const newRow = tableBody.insertRow();
                        const cell1 = newRow.insertCell(0);
                        const cell2 = newRow.insertCell(1);

                        cell1.innerHTML = `<input type="text" class="form-control bg-dark text-white" value="${referee}">`;
                        cell2.innerHTML = '<button class="btn btn-danger btn-sm" onclick="deleteRow(this)">حذف</button>';
                    });
                })
                .catch(error => console.error("Error fetching referees:", error));
        });

     $('#championshipModal').on('show.bs.modal', function () {
    $.get('/Admin/GetTeams', function (response) {
        console.log(response); 
        
        if (response.success) {
           
            $('input[data-target="first"]').val(response.data.first);
            $('input[data-target="second"]').val(response.data.second);
            $('input[data-target="third"]').val(response.data.third);
        } else {
            alert("Error: " + response.message);
        }
    });
});

    document.addEventListener('DOMContentLoaded', function () {
        // Add click event listeners to all feedback buttons
        document.querySelectorAll('.view-feedback-btn').forEach(button => {
            button.addEventListener('click', function () {
                // Retrieve the feedback description from the button's data-feedback attribute
                const feedbackMessage = this.getAttribute('data-feedback');

                // Set the modal content
                document.getElementById('modalFeedbackContent').textContent = feedbackMessage;
            });
        });
    });





    </script>  
</body>
